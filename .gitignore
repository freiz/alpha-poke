# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/

# Rust build output
/rust/**/target/

# Local Showdown server
vendor/

# Experiment artifacts (keep dirs, ignore contents)
runs/
checkpoints/
logs/
wandb/
*.pt
*.pth
*.ckpt
*.npz

# Data: all of data/ is local (layout: alpha_poke/paths.py, README "Data"). The curated team data
# that is kept in git lives in teams/ (top level): the forum catalog and the fixed pools.
/data/

# Editor / OS
.vscode/
.idea/
.DS_Store

# Secrets (API keys)
.env

# third-party bots run as separate processes (own venvs, not part of this repo)
/external/

# test fixtures are data the tests need, whatever their type
!/tests/fixtures/**
