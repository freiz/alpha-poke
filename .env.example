# Copy to .env (git-ignored) and fill in. Never commit .env.
# Only scripts/play_public.py and scripts/ladder.py with --public read it: a Showdown account
# registered as a bot (README, "Playing on the official server"). Everything else runs locally.
PS_BOT_USERNAME=
PS_BOT_PASSWORD=
# Game reviews' write-up (scripts/review_game.py --llm): an OpenAI-compatible chat endpoint
COACH_LLM_BASE_URL=
COACH_LLM_API_KEY=
COACH_LLM_MODEL=
