# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/

# Rust build output
/rust/*/target/

# Local Showdown server
vendor/

# Experiment artifacts (keep dirs, ignore contents)
runs/
checkpoints/
logs/
wandb/
*.pt
*.pth
*.ckpt
*.npz

# Data (except the team catalog and the evaluation pools: small; the crawl is slow to redo and
# the replay pools cannot be rebuilt as they were)
/data/*
!/data/teams/
/data/teams/*
!/data/teams/catalog.jsonl
!/data/teams/pools/
# diagnostic pools sampled from a seed (data/selfplay/diag): reproducible, not kept in git
/data/teams/pools/wide*/

# Editor / OS
.vscode/
.idea/
.DS_Store

# Secrets (API keys)
.env

# third-party bots run as separate processes (own venvs, not part of this repo)
/external/
