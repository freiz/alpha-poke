# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/

# Rust build output
/rust/**/target/

# Local Showdown server
vendor/

# Experiment artifacts (keep dirs, ignore contents)
runs/
checkpoints/
logs/
wandb/
*.pt
*.pth
*.ckpt
*.npz

# Data: all of data/ is local, except the curated team data -- the forum catalog and the fixed
# pools named here (small; the crawl is slow to redo, the replay pools cannot be rebuilt as they
# were). Any other pool (sampled, simulated, candidates) stays local: listed by name, not excluded.
/data/*
!/data/teams/
/data/teams/*
!/data/teams/catalog.jsonl
!/data/teams/pools/
/data/teams/pools/*
!/data/teams/pools/ab600b/
!/data/teams/pools/forum_curated/
!/data/teams/pools/replay40/
!/data/teams/pools/replay40b/

# Editor / OS
.vscode/
.idea/
.DS_Store

# Secrets (API keys)
.env

# third-party bots run as separate processes (own venvs, not part of this repo)
/external/
